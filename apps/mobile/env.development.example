# ─────────────────────────────────────────────────────────────────────────
#  apps/mobile/.env.development  —  LOCAL mobile config (read by app.config.ts)
#
#  Copy this file to `.env.development` (gitignored) and fill in real values:
#      cp apps/mobile/env.development.example apps/mobile/.env.development
#
#  EXPO_PUBLIC_* are inlined into the JS bundle (not secret).
# ─────────────────────────────────────────────────────────────────────────

# Backend URL. Local dev: your local Worker (`pnpm --filter @selfie/backend dev`
# → http://localhost:8787). On a real phone in Expo Go use your Mac's LAN IP
# (e.g. http://192.168.1.20:8787) or the deployed Worker URL.
EXPO_PUBLIC_API_BASE_URL="http://localhost:8787"

# Cloudflare Stream customer code (same customer-XXXX as the backend)
EXPO_PUBLIC_STREAM_CUSTOMER_CODE="<STREAM_CUSTOMER_CODE>"

# ── World ID ────────────────────────────────────────────────────────
# The client ships ZERO World ID packages — app_id/rp_id/action/signing key
# all live on the backend (wrangler.toml + secrets). Only the dev toggle here:
# 1 → skip World App entirely (backend must run WORLD_VERIFY_MODE=mock)
EXPO_PUBLIC_WORLD_MOCK="1"

# ── EAS Update (delivery to testers via Expo Go) ─────────────────────────
EAS_PROJECT_ID="<EAS_PROJECT_ID>"          # from `eas init`
