# Copy to .env.development (gitignored). EXPO_PUBLIC_* values are inlined
# into the JS bundle.

# Local Worker (use your LAN IP on a real phone) or the deployed API URL.
EXPO_PUBLIC_API_BASE_URL="http://localhost:8787"

# Cloudflare Stream customer code — bare code only (e.g. "tjsz92je6cx0a0w7").
EXPO_PUBLIC_STREAM_CUSTOMER_CODE="<STREAM_CUSTOMER_CODE>"

# 1 → skip World App during local dev (backend must run WORLD_VERIFY_MODE=mock).
EXPO_PUBLIC_WORLD_MOCK="1"

# EAS Update project (from `eas init`).
EAS_PROJECT_ID="<EAS_PROJECT_ID>"
