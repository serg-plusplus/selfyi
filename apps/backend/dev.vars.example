# Copy to .dev.vars (gitignored) for `wrangler dev`.
# Production secrets are set via `wrangler secret put <NAME>`.

# HS256 session signing key. Generate: openssl rand -base64 48
JWT_SECRET="dev-only-change-me-min-32-chars-xxxxxxxxxxxxxxxx"

# Cloudflare Stream
STREAM_ACCOUNT_ID="<CF_ACCOUNT_ID>"
STREAM_CUSTOMER_CODE="<STREAM_CUSTOMER_CODE>"
STREAM_API_TOKEN="<CF_STREAM_API_TOKEN>"
STREAM_WEBHOOK_SECRET="<STREAM_WEBHOOK_SECRET>"

# World ID (Developer Portal). The RP signing key is server-only.
WORLD_APP_ID="app_xxxxxxxxxxxxxxxx"
WORLD_RP_ID="rp_xxxxxxxxxxxxxxxx"
WORLD_ACTION="go-selfie"
WORLD_ENV="staging"
APP_SCHEME="selfie"
WORLD_RP_SIGNING_KEY="<WORLD_RP_SIGNING_KEY_HEX>"
# "mock" skips World App entirely (dev only, pairs with EXPO_PUBLIC_WORLD_MOCK=1).
WORLD_VERIFY_MODE="mock"

# Seed script (scripts/seed.ts). Free key: https://www.pexels.com/api/
PEXELS_API_KEY="<PEXELS_API_KEY>"

# CORS (dev)
CORS_ORIGINS="http://localhost:8081"
